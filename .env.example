# DeepSeek (OpenAI-compatible API)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com

# LLM Model Configuration
PRIMARY_MODEL=deepseek-chat
FALLBACK_MODEL=deepseek-chat
EMBEDDING_MODEL=/Users/zing/Desktop/models/embeding
JUDGE_MODEL=deepseek-chat

# Milvus Vector Store
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=intellilens_knowledge

# Redis (distributed rate limiting + caching)
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20
REDIS_SOCKET_TIMEOUT=5.0

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-secure-random-string
JWT_ALGORITHM=HS256

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
RATE_LIMIT_PER_MINUTE=60

# Evaluation
BAD_CASES_PATH=data/bad_cases.jsonl
EVAL_SCORE_THRESHOLD=0.8
